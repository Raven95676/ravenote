---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/jetbrains-mono/wght-italic.css";

interface Props {
	class: string;
}
const className = Astro.props.class;
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base max-w-none! custom-md ${className}`}>
    <!--<div class="prose dark:prose-invert max-w-none custom-md">-->
    <!--<div class="max-w-none custom-md">-->
    <slot/>
</div>

<script>
function scrollToHash(hash: string, behavior: ScrollBehavior) {
    if (!hash) return false;

    const target = document.getElementById(decodeURIComponent(hash.slice(1)));
    const article = target?.closest(".markdown-content");
    if (!target || !article) return false;

    const sections = Array.from(article.querySelectorAll<HTMLElement>(":scope > section"));
    const targetSectionIndex = sections.findIndex(section => section.contains(target));
    sections.slice(0, targetSectionIndex + 1).forEach(section => {
        section.style.contentVisibility = "visible";
    });

    requestAnimationFrame(() => {
        if (behavior === "auto") {
            const root = document.documentElement;
            const previousScrollBehavior = root.style.scrollBehavior;
            root.style.scrollBehavior = "auto";
            target.scrollIntoView({ behavior: "auto", block: "start" });
            requestAnimationFrame(() => {
                root.style.scrollBehavior = previousScrollBehavior;
            });
            return;
        }
        target.scrollIntoView({ behavior, block: "start" });
    });
    return true;
}

function restoreHashPosition() {
    scrollToHash(window.location.hash, "auto");
}

document.addEventListener("click", function (e: MouseEvent) {
    const target = e.target as Element | null;
    if (target && target.classList.contains("copy-btn")) {
        const preEle = target.closest("pre");
        const codeEle = preEle?.querySelector("code");
        const code = Array.from(codeEle?.querySelectorAll(".code:not(summary *)") ?? [])
            .map(el => el.textContent)
            .map(t => t === "\n" ? "" : t)
            .join("\n");
        navigator.clipboard.writeText(code);

        const timeoutId = target.getAttribute("data-timeout-id");
        if (timeoutId) {
            clearTimeout(parseInt(timeoutId));
        }

        target.classList.add("success");

        // 设置新的timeout并保存ID到按钮的自定义属性中
        const newTimeoutId = setTimeout(() => {
            target.classList.remove("success");
        }, 1000);

        target.setAttribute("data-timeout-id", newTimeoutId.toString());
    }
});

window.addEventListener("popstate", restoreHashPosition);
if (document.readyState === "complete") {
    restoreHashPosition();
} else {
    window.addEventListener("load", restoreHashPosition, { once: true });
}

const setupSwupHashNavigation = () => {
    window.swup.hooks.on("page:view", restoreHashPosition);
};

if (window.swup?.hooks) {
    setupSwupHashNavigation();
} else {
    document.addEventListener("swup:enable", setupSwupHashNavigation, { once: true });
}
</script>
