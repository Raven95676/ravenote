---
import type { MarkdownHeading } from "astro";
import I18nKey from "../../i18n/i18nKey";
import { stripLocalePrefix, toLocale } from "../../i18n/locale";
import { i18n } from "../../i18n/translation";
import { siteConfig } from "../../config";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";
import TOC from "./TOC.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings ?? [];
const lang = toLocale(Astro.currentLocale);
const isPostsRoute = stripLocalePrefix(Astro.url.pathname).startsWith("/posts/");
const showToc = siteConfig.toc.enable && isPostsRoute && headings.length > 0;
---
<div id="sidebar" class:list={[className, "w-full flex flex-col"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="toc" class="flex-1">
        {showToc ? (
            <>
                <div id="sidebar-sticky" class="transition-all duration-700 w-full sticky top-4 z-10">
                    <WidgetLayout id="sidebar-toc" name={i18n(I18nKey.tableOfContents, lang)} class="hidden lg:block">
                        <div id="toc-inner-wrapper" class="relative max-h-[min(50vh,28rem)] overflow-y-auto overflow-x-hidden hide-scrollbar pr-1">
                            <TOC headings={headings} class="relative block"></TOC>
                        </div>
                    </WidgetLayout>
                </div>
                <div class="flex flex-col w-full gap-4 mt-4">
                    <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
                    <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
                </div>
            </>
        ) : (
            <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 sticky top-4">
                <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
                <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
            </div>
        )}
    </div>
</div>
